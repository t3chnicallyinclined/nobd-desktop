<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>NobdHidMaestro</RootNamespace>
    <AssemblyName>hidmaestro-sync</AssemblyName>
  </PropertyGroup>

  <!-- References the PREBUILT HIDMaestro.Core.dll (driver embedded) so we never
       need the WDK. Fetch it with scripts\fetch-hidmaestro.ps1 (see README). -->
  <ItemGroup>
    <Reference Include="HIDMaestro.Core">
      <HintPath>lib\HIDMaestro.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
